<!doctype html>
<html dir="rtl" lang="he">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#05070e" />
<title>החתמות מולטימדיה</title>

<!-- ===== CDN dependencies (no build step) ===== -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&family=Rubik:wght@500;600;700;800&display=swap" rel="stylesheet">
<script>
/* ---- boot guard: silence the Tailwind dev notice + capture any load/runtime error
        so the app can never fail to a silent black screen ---- */
window.__bootErrors = [];
window.addEventListener('error', function(e){
  var t = e.target || {};
  if (t.src || t.href) window.__bootErrors.push('נכשלה טעינה של: ' + (t.src || t.href));
  else if (e.message) window.__bootErrors.push(e.message);
}, true);
(function(){
  var mute = ['cdn.tailwindcss.com','in-browser Babel','babeljs.io'];
  var filter = function(fn){ return function(){ var m = arguments[0];
    if (typeof m === 'string'){ for (var i=0;i<mute.length;i++){ if (m.indexOf(mute[i]) > -1) return; } }
    return fn.apply(console, arguments); }; };
  console.warn = filter(console.warn);
  console.log  = filter(console.log);
})();
window.addEventListener('load', function(){
  setTimeout(function(){
    var root = document.getElementById('root');
    if (!root || root.getAttribute('data-mounted') === '1') return;
    var miss = [];
    if (!window.React) miss.push('React');
    if (!window.ReactDOM) miss.push('ReactDOM');
    if (!window.Babel) miss.push('Babel');
    if (!window.QRCode) miss.push('QRCode');
    if (typeof window.XLSX === 'undefined') miss.push('XLSX');
    if (miss.length === 0 && window.__bootErrors.length === 0) return;
    root.innerHTML =
      '<div dir="rtl" style="max-width:540px;margin:12vh auto;padding:26px;font-family:Heebo,Arial,sans-serif;'
      + 'color:#eaeefb;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:22px;line-height:1.75">'
      + '<h2 style="margin:0 0 10px;font-size:20px">האפליקציה לא נטענה במלואה</h2>'
      + (miss.length ? '<p>ספריות שלא נטענו מהרשת: <b style="color:#fcd34d">' + miss.join(', ') + '</b></p>' : '')
      + (window.__bootErrors.length ? '<pre style="white-space:pre-wrap;font-size:12px;color:#fca5a5;margin:8px 0 0">' + window.__bootErrors.join('\n') + '</pre>' : '')
      + '<p style="font-size:13px;color:#9aa6bd;margin-top:14px">כמעט תמיד זה אומר שהרשת חוסמת גישה לשרת חיצוני. '
      + 'צלם/י מסך של ההודעה הזו ושלח/י לי — זה מראה בדיוק מה חסום ואני מתקן בהתאם.</p></div>';
  }, 4000);
});
</script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/react@18.3.1/umd/react.production.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@babel/standalone@7/babel.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/gh/davidshimjs/qrcodejs@master/qrcode.min.js"></script>

<script>
tailwind.config = {
  theme: { extend: {
    fontFamily: { sans: ['Heebo','system-ui','-apple-system','sans-serif'], num:['Rubik','Heebo','sans-serif'] },
    colors: { ink:'#0b1220', brass:'#e7b84b', brass2:'#c99a2e', cyan:'#5cc8ff' }
  }}
}
</script>

<style>
:root{
  --bg0:#05070e; --brass:#e7b84b; --brass2:#c99a2e; --cyan:#5cc8ff;
  --stroke:rgba(255,255,255,.10); --stroke2:rgba(255,255,255,.18);
  --text:#eaeefb; --muted:#9aa6bd; --muted2:#6b7688;
  --px:0; --py:0;
}
*{ -webkit-tap-highlight-color:transparent }
html,body,#root{height:100%}
body{
  font-family:'Heebo',system-ui,sans-serif; color:var(--text); background:var(--bg0);
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; overflow-x:hidden;
}
.num{font-family:'Rubik','Heebo',sans-serif; font-feature-settings:"tnum"; letter-spacing:-.02em}

/* ambient background */
.ambient{position:fixed; inset:0; z-index:-2; overflow:hidden; pointer-events:none;
  background:
   radial-gradient(1200px 820px at 84% -12%, rgba(84,62,150,.42), transparent 60%),
   radial-gradient(1000px 720px at 6% 10%, rgba(14,96,140,.34), transparent 55%),
   radial-gradient(920px 900px at 58% 122%, rgba(201,154,46,.16), transparent 60%),
   linear-gradient(180deg,#070b17,#05070e 70%);
}
.layer{position:absolute; inset:0; will-change:transform}
.l1{transform:translate3d(calc(var(--px)*22px),calc(var(--py)*22px),0)}
.l2{transform:translate3d(calc(var(--px)*-30px),calc(var(--py)*18px),0)}
.l3{transform:translate3d(calc(var(--px)*16px),calc(var(--py)*-15px),0)}
.blob{position:absolute; border-radius:50%; filter:blur(72px); opacity:.5; mix-blend-mode:screen; will-change:transform}
.b1{width:48vw;height:48vw;left:-8vw;top:-12vw;background:radial-gradient(circle,#4a4fb0,transparent 70%);animation:drift 20s ease-in-out infinite}
.b2{width:42vw;height:42vw;right:-6vw;top:4vh;background:radial-gradient(circle,#0f78ad,transparent 70%);animation:drift 25s ease-in-out -6s infinite}
.b3{width:40vw;height:40vw;left:22vw;bottom:-18vw;background:radial-gradient(circle,#c39433,transparent 70%);opacity:.34;animation:drift 30s ease-in-out -14s infinite}
@keyframes drift{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(0,-4%,0) scale(1.05)}}
.ambient-grid{position:absolute; inset:0; opacity:.5;
  background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
  background-size:46px 46px;
  -webkit-mask-image:radial-gradient(circle at 50% 28%, #000, transparent 78%);
  mask-image:radial-gradient(circle at 50% 28%, #000, transparent 78%);
}

/* glass surfaces */
.card{
  position:relative;
  background:linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.028));
  border:1px solid var(--stroke); border-radius:22px;
  box-shadow:0 1px 0 0 rgba(255,255,255,.07) inset, 0 16px 44px -18px rgba(0,0,0,.62), 0 3px 10px -6px rgba(0,0,0,.5);
  -webkit-backdrop-filter:blur(18px) saturate(140%); backdrop-filter:blur(18px) saturate(140%);
}
.lift{transition:box-shadow .28s ease, border-color .28s ease}
.lift:hover{box-shadow:0 1px 0 0 rgba(255,255,255,.09) inset, 0 26px 60px -20px rgba(0,0,0,.72); border-color:var(--stroke2)}
.glass-modal{
  background:linear-gradient(180deg, rgba(24,29,44,.9), rgba(13,17,29,.94));
  border:1px solid var(--stroke2); border-radius:28px;
  box-shadow:0 40px 100px -24px rgba(0,0,0,.85), 0 1px 0 rgba(255,255,255,.08) inset;
  -webkit-backdrop-filter:blur(28px) saturate(150%); backdrop-filter:blur(28px) saturate(150%);
}
.hairline{background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent); height:1px}

/* inputs */
.input{
  width:100%; background:rgba(255,255,255,.045); border:1px solid var(--stroke);
  border-radius:14px; padding:.7rem .9rem; font-size:.9rem; color:var(--text);
  outline:none; transition:border-color .18s, box-shadow .18s, background .18s;
}
.input::placeholder{color:var(--muted2)}
.input:focus{border-color:rgba(231,184,75,.6); box-shadow:0 0 0 4px rgba(231,184,75,.15); background:rgba(255,255,255,.07)}
select.input option{color:#0b1220}
input[type=date].input, input[type=time].input{color-scheme:dark}

/* buttons */
.btn{display:inline-flex; align-items:center; justify-content:center; gap:.5rem; border-radius:14px;
  padding:.64rem 1.05rem; font-size:.9rem; font-weight:600; cursor:pointer; white-space:nowrap;
  transition:transform .12s cubic-bezier(.2,.8,.3,1.5), box-shadow .22s, background .2s, opacity .2s, border-color .2s;}
.btn:active{transform:scale(.955)}
.btn:disabled{opacity:.5; cursor:default}
.btn-brass{background:linear-gradient(180deg,#f3cb63,#c99a2e); color:#1b1405;
  box-shadow:0 10px 26px -10px rgba(231,184,75,.65), 0 1px 0 rgba(255,255,255,.45) inset}
.btn-brass:hover{box-shadow:0 14px 34px -10px rgba(231,184,75,.8), 0 1px 0 rgba(255,255,255,.55) inset}
.btn-glass{background:rgba(255,255,255,.08); color:var(--text); border:1px solid var(--stroke2)}
.btn-glass:hover{background:rgba(255,255,255,.14)}
.btn-outline{background:transparent; border:1px solid var(--stroke2); color:var(--text)}
.btn-outline:hover{background:rgba(255,255,255,.06)}
.btn-ghost{background:transparent; color:var(--muted)}
.btn-ghost:hover{background:rgba(255,255,255,.06); color:var(--text)}
.btn-danger{background:linear-gradient(180deg,#fb7185,#e11d48); color:#fff; box-shadow:0 10px 26px -10px rgba(225,29,72,.6)}

/* chips */
.chip{display:inline-block; border-radius:999px; border:1px solid; padding:.15rem .6rem; font-size:.72rem; font-weight:600; backdrop-filter:blur(4px)}

/* 3D tilt */
.tilt{transition:transform .3s cubic-bezier(.2,.8,.3,1); transform-style:preserve-3d; will-change:transform}

/* skeleton */
.skeleton{position:relative; overflow:hidden; background:rgba(255,255,255,.055); border-radius:12px}
.skeleton::after{content:""; position:absolute; inset:0; transform:translateX(-100%);
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.10),transparent); animation:sheen 1.5s infinite}
@keyframes sheen{100%{transform:translateX(100%)}}

/* entrances */
.rise{animation:rise .55s cubic-bezier(.2,.7,.2,1) both}
@keyframes rise{from{opacity:0; transform:translateY(16px)}to{opacity:1; transform:none}}
.pop{animation:pop .36s cubic-bezier(.2,.9,.3,1.4) both}
@keyframes pop{from{opacity:0; transform:scale(.94) translateY(10px)}to{opacity:1; transform:none}}
.stagger>*{animation:rise .5s cubic-bezier(.2,.7,.2,1) both}
.stagger>*:nth-child(1){animation-delay:.03s}
.stagger>*:nth-child(2){animation-delay:.08s}
.stagger>*:nth-child(3){animation-delay:.13s}
.stagger>*:nth-child(4){animation-delay:.18s}
.stagger>*:nth-child(5){animation-delay:.23s}
.stagger>*:nth-child(6){animation-delay:.28s}
.stagger>*:nth-child(7){animation-delay:.33s}
.stagger>*:nth-child(8){animation-delay:.38s}

/* signing surface stays light for printed PDF */
.signpad{touch-action:none; background:
  linear-gradient(#dbe2ec 1px,transparent 1px) 0 100%/100% 34px; background-color:#fff}

/* scrollbars */
*{scrollbar-width:thin; scrollbar-color:rgba(255,255,255,.2) transparent}
::-webkit-scrollbar{width:10px; height:10px}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.16); border-radius:10px; border:2px solid transparent; background-clip:padding-box}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.28); background-clip:padding-box}

/* reduced motion */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001s !important; animation-iteration-count:1 !important; transition-duration:.001s !important}
  .layer{transform:none !important}
}
/* lighter on small screens for performance */
@media (max-width:768px){
  .card{-webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px)}
  .blob{filter:blur(56px)}
}

/* print: certificate only, on white */
#print-area{display:none}
@media print{
  body{background:#fff}
  .ambient{display:none !important}
  #app-root{display:none !important}
  #print-area{display:block !important}
  @page{margin:16mm}
}
</style>
</head>
<body>
<div id="root"><div style="display:flex;align-items:center;justify-content:center;height:100vh;color:#9aa6bd;font-family:Heebo,Arial,sans-serif">טוען…</div></div>
<div id="print-area"></div>

<script type="text/babel" data-presets="react">
const { useState, useEffect, useMemo, useRef, useCallback, createContext, useContext } = React;

/* =====================================================================
   CONFIG — paste your Supabase project values here (Settings -> API)
   ===================================================================== */
const SUPABASE_URL = "";       // fill later to switch from demo to a real database
const SUPABASE_ANON_KEY = "";  // the public anon key

/* =====================================================================
   DEMO BACKEND — runs with zero database. Realistic in-memory data,
   every screen and button works, and NOTHING persists: refresh = reset.
   When SUPABASE_URL + SUPABASE_ANON_KEY are filled (and supabase-js is
   loaded) the app automatically uses the real backend instead.
   ===================================================================== */
function makeDemoClient(){
  const now = () => new Date().toISOString();
  const uid = (p='id') => p+'-'+Math.random().toString(36).slice(2,9);
  const dAgo = n => new Date(Date.now()-n*864e5).toISOString();
  const S = {
    profiles: [
      {id:'me', full_name:'מנהל הדגמה',    unit:'מדור מולטימדיה', role:'admin',             created_at:dAgo(120)},
      {id:'u2', full_name:'רס״ל דנה כהן',  unit:'מדור מולטימדיה', role:'equipment_manager', created_at:dAgo(80)},
      {id:'u3', full_name:'סמל יואב לוי',  unit:'פלוגה א׳',        role:'user',              created_at:dAgo(30)},
    ],
    categories: ['עדשות','מצלמות/גו פרו','חצובות/ראשים','מחשבים','וידאו','ציוד','כבלים','תאורה','מצלמות','אודיו','חצובות','גו פרו','חשמל','אחסון','רחפן','תיקים','מרום X','מצלמה'].map((n,i)=>({id:'c'+(i+1),name:n})),
    equipment: [], borrows: [], borrow_items: [], returns: [], audit_log: [],
  };
  const catId = n => (S.categories.find(c=>c.name===n)||{}).id;
  const mkEq = (name,catName,quantity,status,ago)=>({
    id:uid('eq'), name, category_id:catId(catName), quantity, status:status||'available',
    serial_number:null, asset_number:null, manufacturer:null, model:null, price:null,
    location:null, notes:'', image_url:null, purchase_date:null, warranty_expiry:null, created_at:dAgo(ago||45),
  });
  S.equipment = [
    mkEq('16-35','עדשות',1),
    mkEq('70-200','עדשות',1),
    mkEq('100-400','עדשות',1),
    mkEq('50MM','עדשות',1),
    mkEq('גו פרו 360','מצלמות/גו פרו',1),
    mkEq('גו פרו','מצלמות/גו פרו',4),
    mkEq('ראש','חצובות/ראשים',4),
    mkEq('מחשב צבאי','מחשבים',35),
    mkEq('אטם 4 כניסות','וידאו',1),
    mkEq('אטם 8 כניסות','וידאו',1),
    mkEq('פליקן קטן','ציוד',1),
    mkEq('כבל מטען אפל למקבוק','מחשבים',1),
    mkEq('מטען למקבוק W35','מחשבים',6),
    mkEq('מטען למקבוק W140','מחשבים',2),
    mkEq('ראש 140','חצובות/ראשים',1),
    mkEq('פליקן גדול','ציוד',1),
    mkEq('USB C-C','כבלים',3),
    mkEq('תאורת GVM','תאורה',14),
    mkEq('Aputure','תאורה',2),
    mkEq('Sony A7IIIS','מצלמות',1),
    mkEq('Nikon','מצלמות',2),
    mkEq('Sony A73','מצלמות',1),
    mkEq('Sony A7II','מצלמות',1),
    mkEq('שוטגאן מייק','אודיו',1),
    mkEq('ערכת Saramonic','אודיו',2),
    mkEq('חצובות תאורה','תאורה',1),
    mkEq('חצובות מצלמה','חצובות',5),
    mkEq('סוללות גו פרו','גו פרו',4),
    mkEq('סוללות גו פרו 360','גו פרו',40),
    mkEq('צגי מחשב','מחשבים',2),
    mkEq('תוף חשמל','חשמל',6),
    mkEq('מטענים לגו פרו','גו פרו',1),
    mkEq('סוללות Sony A72','מצלמות',15),
    mkEq('סוללות Nikon','מצלמות',2),
    mkEq('סוללות Sony A73','מצלמות',3),
    mkEq('כונן 1TB','אחסון',4),
    mkEq('כונן 2TB','אחסון',2),
    mkEq('אביזרים לגו פרו','גו פרו',4),
    mkEq('USB-C','כבלים',79),
    mkEq('מתאם גו פרו','גו פרו',23),
    mkEq('SD 128GB','אחסון',11),
    mkEq('SD 64GB','אחסון',4),
    mkEq('SD 32GB','אחסון',4),
    mkEq('24-70','עדשות',2),
    mkEq('תיק רחפן','רחפן',2),
    mkEq('תיק צד למצלמה','תיקים',4),
    mkEq('תיק גב','תיקים',5),
    mkEq('מפצלים','חשמל',2),
    mkEq('מחשב טיפש','מחשבים',5),
    mkEq('Mac Studio','מחשבים',1),
    mkEq('MacBook','מחשבים',3),
    mkEq('מקרר','ציוד',1),
    mkEq('מיקרו','אודיו',1),
    mkEq('מכונת קרח','ציוד',1),
    mkEq('מטענים','מרום X',10),
    mkEq('מתאמים','מרום X',22),
    mkEq('מערכת','מרום X',18),
    mkEq('משקפי מצלמה','מצלמה',1),
    mkEq('רפלקטור','ציוד',1),
    mkEq('כונן 8TB','אחסון',1),
    mkEq('כונן 16TB','אחסון',2),
    mkEq('רחפן','רחפן',1),
    mkEq('שלט','רחפן',1),
    mkEq('סוללות לרחפן','רחפן',5),
    mkEq('מטען לסוללות רחפן','רחפן',1),
    mkEq('microSD 128GB','אחסון',7),
    mkEq('microSD 64GB','אחסון',2),
    mkEq('microSD 256GB','אחסון',1),
    mkEq('microSD 32GB','אחסון',10),
  ];
  const mkBorrow = (name,pn,unit,phone,eqName,agoOut,retInDays,status)=>{
    const id=uid('b'); const e=S.equipment.find(x=>x.name===eqName);
    S.borrows.push({id, full_name:name, personal_number:pn, unit, phone, purpose:'צילום פעילות יחידתית',
      checkout_date:dAgo(agoOut).slice(0,10), checkout_time:'09:00',
      expected_return_date:dAgo(-retInDays).slice(0,10), expected_return_time:'17:00',
      status, actual_return_at:null, signature_path:null, created_at:dAgo(agoOut)});
    if(e){ S.borrow_items.push({id:uid('bi'), borrow_id:id, equipment_id:e.id, quantity:1}); if(status==='active'||status==='overdue') e.status='borrowed'; }
    return id;
  };
  const b1 = mkBorrow('סמל יואב לוי','8123456','פלוגה א׳','050-1234567','70-200',5,3,'active');
  mkBorrow('רב״ט מאיה בר','8987654','פלוגה ב׳','052-7654321','גו פרו 360',9,-2,'overdue');
  const rId = mkBorrow('סמל יואב לוי','8123456','פלוגה א׳','050-1234567','Sony A7IIIS',30,-20,'returned');
  const rB = S.borrows.find(b=>b.id===rId); if(rB) rB.actual_return_at = dAgo(22);
  mkBorrow('טוראי ליאור אבן','1122334','פלוגה ג׳','054-1112223','Sony A73',0,4,'pending');
  S.audit_log = [
    {id:uid('a'),action:'INSERT',entity_type:'equipment',entity_id:S.equipment[0].id,actor_name:'מנהל הדגמה',created_at:dAgo(3)},
    {id:uid('a'),action:'BORROW',entity_type:'borrows',entity_id:b1,actor_name:'רס״ל דנה כהן',created_at:dAgo(5)},
    {id:uid('a'),action:'UPDATE',entity_type:'equipment',entity_id:S.equipment[6].id,actor_name:'מנהל הדגמה',created_at:dAgo(2)},
  ];
  const blobs = {};
  const clone = r => ({...r});
  const catOf = id => { const c=S.categories.find(c=>c.id===id); return c?{name:c.name}:null; };
  const itemsOf = bid => S.borrow_items.filter(bi=>bi.borrow_id===bid).map(bi=>{
    const e=S.equipment.find(x=>x.id===bi.equipment_id)||{};
    return {quantity:bi.quantity, equipment:{name:e.name, serial_number:e.serial_number}};
  });
  function run(q){
    const tbl = S[q.table] || [];
    if(q._op==='insert'){
      const arr = Array.isArray(q._payload)?q._payload:[q._payload];
      const ins = arr.map(p=>{ const r={id:uid(q.table.slice(0,2)), created_at:now(), ...p}; tbl.push(r); return r; });
      return {data:ins, error:null};
    }
    if(q._op==='update'){
      const rows = tbl.filter(r=>q.filters.every(f=>f(r)));
      rows.forEach(r=>Object.assign(r,q._payload));
      return {data:rows.map(clone), error:null};
    }
    if(q._op==='delete'){
      const keep=[], del=[]; tbl.forEach(r=>(q.filters.every(f=>f(r))?del:keep).push(r));
      S[q.table]=keep; return {data:del, error:null};
    }
    let rows = tbl.filter(r=>q.filters.every(f=>f(r)));
    if(q._order){ const {c,asc}=q._order; rows=[...rows].sort((a,b)=>{ const x=a[c]??'', y=b[c]??''; return x===y?0:(x>y?1:-1)*(asc?1:-1); }); }
    const count = rows.length;
    if(q._limit!=null) rows = rows.slice(0,q._limit);
    if(q._head) return {data:null, count, error:null};
    rows = rows.map(clone);
    if(q.table==='equipment' && /category:/.test(q.cols)) rows.forEach(r=>r.category=catOf(r.category_id));
    if(q.table==='borrows'  && /borrow_items/.test(q.cols)) rows.forEach(r=>r.borrow_items=itemsOf(r.id));
    if(q._single) return {data:rows[0]||null, count, error:null};
    return {data:rows, count, error:null};
  }
  function QB(table){
    return {
      table, cols:'*', filters:[], _order:null, _limit:null, _single:false, _head:false, _op:'select', _payload:null,
      select(c,o){ this.cols=c||'*'; if(o&&o.head)this._head=true; return this; },
      eq(c,v){ this.filters.push(r=>r[c]===v); return this; },
      neq(c,v){ this.filters.push(r=>r[c]!==v); return this; },
      in(c,a){ this.filters.push(r=>a.indexOf(r[c])>-1); return this; },
      gte(c,v){ this.filters.push(r=>((r[c]??'')>=v)); return this; },
      lte(c,v){ this.filters.push(r=>((r[c]??'')<=v)); return this; },
      gt(c,v){ this.filters.push(r=>((r[c]??'')>v)); return this; },
      lt(c,v){ this.filters.push(r=>((r[c]??'')<v)); return this; },
      order(c,o){ this._order={c,asc:!o||o.ascending!==false}; return this; },
      limit(n){ this._limit=n; return this; },
      single(){ this._single=true; return this; },
      insert(p){ this._op='insert'; this._payload=p; return this; },
      update(p){ this._op='update'; this._payload=p; return this; },
      delete(){ this._op='delete'; return this; },
      then(res){ try{ res(run(this)); }catch(e){ res({data:null,error:{message:String(e&&e.message||e)}}); } },
    };
  }
  function rpc(name,p){ return { then(res){ try{ res(runRpc(name,p)); }catch(e){ res({data:null,error:{message:String(e&&e.message||e)}}); } } }; }
  function runRpc(name,p){
    if(name==='create_borrow'){
      const id=uid('b');
      const pending = !!p.p_needs_approval;
      S.borrows.push({id, full_name:p.p_full_name, personal_number:p.p_personal_number, unit:p.p_unit, phone:p.p_phone,
        purpose:p.p_purpose, checkout_date:p.p_checkout_date, checkout_time:p.p_checkout_time,
        expected_return_date:p.p_expected_return_date, expected_return_time:p.p_expected_return_time,
        status: pending?'pending':'active', actual_return_at:null, signature_path:p.p_signature_path, created_at:now()});
      (p.p_items||[]).forEach(it=>{ S.borrow_items.push({id:uid('bi'), borrow_id:id, equipment_id:it.equipment_id, quantity:it.quantity});
        if(!pending){ const e=S.equipment.find(x=>x.id===it.equipment_id); if(e) e.status='borrowed'; } });
      S.audit_log.unshift({id:uid('a'),action:pending?'REQUEST':'BORROW',entity_type:'borrows',entity_id:id,actor_name:p.p_full_name||'—',created_at:now()});
      return {data:id, error:null};
    }
    if(name==='approve_borrow'){
      const b=S.borrows.find(x=>x.id===p.p_borrow_id);
      if(b){
        if(p.p_approve){ b.status='active';
          S.borrow_items.filter(bi=>bi.borrow_id===b.id).forEach(bi=>{ const e=S.equipment.find(x=>x.id===bi.equipment_id); if(e) e.status='borrowed'; });
        } else { b.status='cancelled'; }
        S.audit_log.unshift({id:uid('a'),action:p.p_approve?'APPROVE':'REJECT',entity_type:'borrows',entity_id:b.id,actor_name:'מנהל',created_at:now()});
      }
      return {data:null, error:null};
    }
    if(name==='process_return'){
      const b=S.borrows.find(x=>x.id===p.p_borrow_id); if(b){ b.status='returned'; b.actual_return_at=now(); }
      S.borrow_items.filter(bi=>bi.borrow_id===p.p_borrow_id).forEach(bi=>{ const e=S.equipment.find(x=>x.id===bi.equipment_id);
        if(e) e.status = p.p_condition==='major_damage' ? 'faulty' : 'available'; });
      S.audit_log.unshift({id:uid('a'),action:'RETURN',entity_type:'borrows',entity_id:p.p_borrow_id,actor_name:'מנהל הדגמה',created_at:now()});
      return {data:null, error:null};
    }
    return {data:null, error:null};
  }
  const storage = { from(){ return {
    async upload(path,file){ try{ if(file) blobs[path]=URL.createObjectURL(file); }catch(e){} return {error:null}; },
    getPublicUrl(path){ return {data:{publicUrl: blobs[path]||''}}; },
  }; } };
  const auth = {
    async getSession(){ return {data:{session:{user:{id:'me'}}}}; },
    onAuthStateChange(){ return {data:{subscription:{unsubscribe(){}}}}; },
    async signInWithPassword(){ return {error:null}; },
    async signOut(){ setTimeout(()=>location.reload(),40); return {error:null}; },
  };
  return { from:t=>QB(t), rpc, storage, auth };
}

